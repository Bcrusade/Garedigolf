[10-Mar-2025 18:58:42 UTC] SQL Query: SELECT SQL_CALC_FOUND_ROWS  wp_posts.ID
					 FROM wp_posts  INNER JOIN wp_postmeta ON ( wp_posts.ID = wp_postmeta.post_id )  INNER JOIN wp_postmeta AS mt1 ON ( wp_posts.ID = mt1.post_id )
					 WHERE 1=1  AND ( 
  wp_postmeta.meta_key = 'mec_start_date' 
  AND 
  ( 
    ( mt1.meta_key = 'mec_start_date' AND CAST(mt1.meta_value AS DATE) >= '2025-03-10' )
  )
) AND ((wp_posts.post_type = 'mec-events' AND (wp_posts.post_status = 'publish' OR wp_posts.post_status = 'acf-disabled' 
OR wp_posts.post_status = 'private')))
					 GROUP BY wp_posts.ID
					 ORDER BY wp_postmeta.meta_value ASC
					 LIMIT 0, 10
